# Rivium Storage Node.js example - copy this file to .env and fill it in.
# .env is git-ignored. Never commit real keys, and never put the server secret in an app or a browser.

# Console > your project > API keys
RIVIUM_API_KEY=rv_live_YOUR_PUBLIC_KEY
RIVIUM_SERVER_SECRET=rv_srv_YOUR_SERVER_SECRET

# Demo server (npm run server). The app examples call http://<host>:4000/token etc.
PORT=4000
# 127.0.0.1 = only this computer (Android emulator: 10.0.2.2, iOS simulator: localhost). Keep it unless you must.
# For a real phone on your Wi-Fi set HOST=0.0.0.0, use this computer's LAN address in the app, and list that address
# in ALLOWED_HOSTS. Then ANYONE on that network can get user tokens for this project: use a TEST project, and set
# DEMO_TOKEN below.
HOST=127.0.0.1
# Host names / addresses (comma-separated, no port) the server answers to besides localhost, 127.0.0.1, [::1] and
# 10.0.2.2, e.g. ALLOWED_HOSTS=192.168.1.20. Any other Host gets 403 (stops DNS-rebinding pages in your browser).
ALLOWED_HOSTS=
# Optional shared secret for the demo server: when set, every POST must send the header x-demo-token: <value>.
# Put the same value in the app example's settings (see its README). Not a Rivium key.
DEMO_TOKEN=
# Browser origins allowed to call the demo server (the Vite web example runs on 5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8081

# Test buckets the examples use (created by npm run setup-buckets or POST /setup-test-buckets)
PUBLIC_BUCKET=rivium-example-public
PRIVATE_BUCKET=rivium-example-private-images
# Max file size of the private images bucket, in bytes (the "too big" checks upload one byte more)
PRIVATE_BUCKET_MAX_SIZE=1048576

# Optional: Rivium Auth address for createUserToken (default https://auth.rivium.co)
# RIVIUM_AUTH_URL=https://auth.rivium.co
